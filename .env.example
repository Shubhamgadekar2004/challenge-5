# .env.example
# Copy this file to .env.local and fill in your secrets

# Database URL for Prisma (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Gemini API Key for AI services
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# NextAuth secret (use a strong random string)
NEXTAUTH_SECRET="YOUR_RANDOM_SECRET"

# Public app URL used by NextAuth in production
NEXTAUTH_URL="https://your-project.vercel.app"
